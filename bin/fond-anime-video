#!/usr/bin/env python3
# fond-anime-video : fenêtre de la vidéo du fond animé. Comme xwinwrap, elle lance le lecteur en
# remplaçant WID par l'identifiant de la fenêtre, et se ferme quand le lecteur s'arrête :
#   fond-anime-video [--type-bureau] LxH+X+Y [--principal] -- mpv -wid WID … -- VIDÉOS…
# fond-anime en lance une par écran, à la taille de l'écran ; la première (--principal) mémorise
# la vidéo quand elle change, met à jour la couleur du fond masqué et relance le fond animé
# (fond-anime actualiser) quand les écrans changent.
# Sans option (picom en glx) : fenêtre hors du gestionnaire de fenêtres (override-redirect), gardée
# tout en bas de l'écran, sous le bureau xfdesktop dont picom rend le fond transparent
# (xwinwrap -ov, lui, se glisse dans la fenêtre du bureau et cache les icônes).
# --type-bureau (Compiz, picom en xrender ou arrêté), comme xwinwrap -fdt : fenêtre de type
# « bureau » gérée par le gestionnaire de fenêtres, au-dessus du fond de xfdesktop et sous les
# applications, sans focus ni clic, sur tous les espaces de travail, hors de la barre des tâches
# et du pager. Elle cache les icônes de xfdesktop : fond-anime-icones les réaffiche par-dessus, et
# la vidéo est gardée entre les deux.
# Pause automatique (si mpv a --input-ipc-server=PRISE), dans les deux cas : la vidéo s'arrête tant
# qu'elle ne se voit pas — fenêtre en plein écran ou agrandie sur son écran et l'espace de travail
# courant, écran éteint, session verrouillée — et reprend ensuite ; désactivée si
# ~/.config/fond-anime/pause-auto contient « off » (fond-anime pause-auto off).
# Changement de vidéo (fond-anime rotation, lu à chaque passage) : mpv a toute la galerie dans sa
# liste de lecture ; la vidéo change après N minutes de bureau visible (la suivante, ou une autre
# au hasard), ou avec l'espace de travail (« espace » : chaque espace a la sienne, dans l'ordre de
# la galerie, en partant de la vidéo choisie sur l'espace où elle l'a été).

import ctypes
import json
import os
import random
import re
import shutil
import signal
import socket
import subprocess
import sys
import time
from ctypes import POINTER, byref, c_char_p, c_int, c_long, c_ubyte, c_uint, c_ulong, c_ushort, c_void_p

x11 = ctypes.CDLL("libX11.so.6")
x11.XOpenDisplay.argtypes = [c_char_p]
x11.XOpenDisplay.restype = c_void_p
x11.XDefaultRootWindow.argtypes = [c_void_p]
x11.XDefaultRootWindow.restype = c_ulong
x11.XQueryTree.argtypes = [c_void_p, c_ulong, POINTER(c_ulong), POINTER(c_ulong),
                           POINTER(POINTER(c_ulong)), POINTER(c_uint)]
for nom in ("XLowerWindow", "XMapWindow", "XDestroyWindow"):
    getattr(x11, nom).argtypes = [c_void_p, c_ulong]
x11.XFlush.argtypes = [c_void_p]
x11.XFree.argtypes = [c_void_p]
x11.XCloseDisplay.argtypes = [c_void_p]
x11.XStoreName.argtypes = [c_void_p, c_ulong, c_char_p]


class XSetWindowAttributes(ctypes.Structure):
    _fields_ = [("background_pixmap", c_ulong), ("background_pixel", c_ulong), ("border_pixmap", c_ulong),
                ("border_pixel", c_ulong), ("bit_gravity", c_int), ("win_gravity", c_int),
                ("backing_store", c_int), ("backing_planes", c_ulong), ("backing_pixel", c_ulong),
                ("save_under", c_int), ("event_mask", c_long), ("do_not_propagate_mask", c_long),
                ("override_redirect", c_int), ("colormap", c_ulong), ("cursor", c_ulong)]


class XClassHint(ctypes.Structure):
    _fields_ = [("res_name", c_char_p), ("res_class", c_char_p)]


class XClientMessageEvent(ctypes.Structure):
    _fields_ = [("type", c_int), ("serial", c_ulong), ("send_event", c_int), ("display", c_void_p),
                ("window", c_ulong), ("message_type", c_ulong), ("format", c_int), ("data", c_long * 5),
                ("reste", c_long * 12)]  # jusqu'à la taille d'un XEvent (24 long)


x11.XCreateWindow.argtypes = [c_void_p, c_ulong, c_int, c_int, c_uint, c_uint, c_uint, c_int, c_uint,
                              c_void_p, c_ulong, POINTER(XSetWindowAttributes)]
x11.XCreateWindow.restype = c_ulong
x11.XSetClassHint.argtypes = [c_void_p, c_ulong, POINTER(XClassHint)]
x11.XInternAtom.argtypes = [c_void_p, c_char_p, c_int]
x11.XInternAtom.restype = c_ulong
x11.XGetWindowProperty.argtypes = [c_void_p, c_ulong, c_ulong, c_long, c_long, c_int, c_ulong, POINTER(c_ulong),
                                   POINTER(c_int), POINTER(c_ulong), POINTER(c_ulong), POINTER(c_void_p)]
x11.XChangeProperty.argtypes = [c_void_p, c_ulong, c_ulong, c_ulong, c_int, c_int, c_void_p, c_int]
x11.XSendEvent.argtypes = [c_void_p, c_ulong, c_int, c_long, c_void_p]
x11.XGetGeometry.argtypes = [c_void_p, c_ulong, POINTER(c_ulong), POINTER(c_int), POINTER(c_int),
                             POINTER(c_uint), POINTER(c_uint), POINTER(c_uint), POINTER(c_uint)]
x11.XTranslateCoordinates.argtypes = [c_void_p, c_ulong, c_ulong, c_int, c_int, POINTER(c_int), POINTER(c_int),
                                      POINTER(c_ulong)]
CW_BACK_PIXEL, CW_OVERRIDE_REDIRECT, INPUT_OUTPUT = 1 << 1, 1 << 9, 1
XA_ATOM, XA_CARDINAL, XA_WM_HINTS, XA_WM_NORMAL_HINTS, XA_WM_SIZE_HINTS = 4, 6, 35, 40, 41
CLIENT_MESSAGE, SUBSTRUCTURE_NOTIFY, SUBSTRUCTURE_REDIRECT = 33, 1 << 19, 1 << 20
try:
    xext = ctypes.CDLL("libXext.so.6")
    xext.DPMSInfo.argtypes = [c_void_p, POINTER(c_ushort), POINTER(c_ubyte)]
    xext.XShapeCombineRectangles.argtypes = [c_void_p, c_ulong, c_int, c_int, c_int, c_void_p, c_int, c_int,
                                             c_int]
except OSError:
    xext = None

# ~/.config, ou $XDG_CONFIG_HOME s'il est défini (comme fond-anime)
CONFIG = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
REGLAGE_PAUSE = os.path.join(CONFIG, "fond-anime", "pause-auto")
REGLAGE_ROTATION = os.path.join(CONFIG, "fond-anime", "rotation")
VIDEO_MEMORISEE = os.path.join(CONFIG, "fond-anime", "video")  # relancée par « fond-anime » seul
ICI = os.path.dirname(os.path.realpath(__file__))
ATOMES = ("_NET_CURRENT_DESKTOP", "_NET_CLIENT_LIST", "_NET_CLIENT_LIST_STACKING", "_NET_WM_DESKTOP",
          "_NET_WM_STATE", "_NET_WM_STATE_FULLSCREEN", "_NET_WM_STATE_MAXIMIZED_VERT",
          "_NET_WM_STATE_MAXIMIZED_HORZ", "_NET_WM_STATE_HIDDEN", "_NET_WM_STATE_BELOW", "_NET_WM_STATE_STICKY",
          "_NET_WM_STATE_SKIP_TASKBAR", "_NET_WM_STATE_SKIP_PAGER", "_NET_WM_WINDOW_TYPE",
          "_NET_WM_WINDOW_TYPE_DESKTOP", "_NET_RESTACK_WINDOW", "_MOTIF_WM_HINTS", "WM_CLASS")

# Une fenêtre peut disparaître entre deux appels : on ignore l'erreur au lieu de quitter
GESTIONNAIRE = ctypes.CFUNCTYPE(c_int, c_void_p, c_void_p)(lambda _d, _e: 0)
x11.XSetErrorHandler.argtypes = [c_void_p]
x11.XSetErrorHandler(ctypes.cast(GESTIONNAIRE, c_void_p))

# Le lecteur reçoit SIGTERM si cette fenêtre disparaît brutalement
AVEC_PARENT = ["setpriv", "--pdeathsig", "TERM"] if shutil.which("setpriv") else []


def tout_en_bas(dpy, racine, fenetre, atomes):
    """Rien que des vidéos du fond animé sous la fenêtre (une par écran) : sans cette exception,
    chacune s'abaisserait à son tour sous les autres, chaque seconde."""
    racine_, parent, n = c_ulong(), c_ulong(), c_uint()
    liste = POINTER(c_ulong)()
    if not x11.XQueryTree(dpy, racine, byref(racine_), byref(parent), byref(liste), byref(n)):
        return True
    resultat = True
    for i in range(n.value):  # de bas en haut
        if liste[i] == fenetre:
            break
        if b"fond-anime-mpv" not in propriete(dpy, liste[i], atomes["WM_CLASS"], texte=True):
            resultat = False
            break
    x11.XFree(liste)
    return resultat


def propriete(dpy, fenetre, atome, texte=False):
    """Valeurs d'une propriété X de format 32 ([] si elle n'existe pas), ou ses octets (format 8)."""
    type_, format_, n, reste, donnees = c_ulong(), c_int(), c_ulong(), c_ulong(), c_void_p()
    if x11.XGetWindowProperty(dpy, fenetre, atome, 0, 4096, 0, 0, byref(type_), byref(format_),
                              byref(n), byref(reste), byref(donnees)) != 0 or not donnees.value:
        return b"" if texte else []
    if texte:
        valeurs = ctypes.string_at(donnees, n.value) if format_.value == 8 else b""
    else:
        tableau = ctypes.cast(donnees, POINTER(c_ulong))
        valeurs = [tableau[i] & 0xFFFFFFFF for i in range(n.value)] if format_.value == 32 else []
    x11.XFree(donnees)
    return valeurs


def ecrire(dpy, fenetre, atome, type_, valeurs):
    """Écrit une propriété X de format 32 (Xlib les veut en tableau de long)."""
    x11.XChangeProperty(dpy, fenetre, atome, type_, 32, 0, (c_long * len(valeurs))(*valeurs), len(valeurs))


def geometrie(dpy, racine, fenetre):
    """(x, y, largeur, hauteur) d'une fenêtre, x et y comptés depuis le coin de l'écran."""
    r, x, y, larg, haut, bord, prof, enfant = c_ulong(), c_int(), c_int(), c_uint(), c_uint(), c_uint(), \
        c_uint(), c_ulong()
    if not (x11.XGetGeometry(dpy, fenetre, byref(r), byref(x), byref(y), byref(larg), byref(haut), byref(bord),
                             byref(prof))
            and x11.XTranslateCoordinates(dpy, fenetre, racine, 0, 0, byref(x), byref(y), byref(enfant))):
        return None
    return x.value, y.value, larg.value, haut.value


def bureau_cache(dpy, racine, atomes, zone):
    """Une fenêtre non réduite, en plein écran ou agrandie, sur l'espace de travail courant, qui
    couvre au moins 60 % de la zone de la vidéo (son écran : x, y, largeur, hauteur)."""
    courant = (propriete(dpy, racine, atomes["_NET_CURRENT_DESKTOP"]) or [0])[0]
    agrandie = {atomes["_NET_WM_STATE_MAXIMIZED_VERT"], atomes["_NET_WM_STATE_MAXIMIZED_HORZ"]}
    x, y, largeur, hauteur = zone
    for client in propriete(dpy, racine, atomes["_NET_CLIENT_LIST"]):
        bureau = (propriete(dpy, client, atomes["_NET_WM_DESKTOP"]) or [courant])[0]
        etats = set(propriete(dpy, client, atomes["_NET_WM_STATE"]))
        if not (bureau in (courant, 0xFFFFFFFF) and atomes["_NET_WM_STATE_HIDDEN"] not in etats
                and (atomes["_NET_WM_STATE_FULLSCREEN"] in etats or agrandie <= etats)):
            continue
        # Avec Compiz, les espaces de travail sont les parties d'un seul grand bureau (extension
        # « wall ») : une fenêtre agrandie sur une autre partie est hors de l'écran. Avec plusieurs
        # écrans, une fenêtre agrandie sur un autre écran ne cache pas cette vidéo, une fenêtre en
        # plein écran étalée sur tous les cache toutes. Une fenêtre agrandie laisse voir le
        # panneau et le dock : elle couvre un peu moins que tout l'écran.
        g = geometrie(dpy, racine, client)
        if g:
            couvert_x = min(g[0] + g[2], x + largeur) - max(g[0], x)
            couvert_y = min(g[1] + g[3], y + hauteur) - max(g[1], y)
            if couvert_x > 0 and couvert_y > 0 and couvert_x * couvert_y >= 0.6 * largeur * hauteur:
                return True
    return False


def ecran_eteint(dpy):
    """Écran mis en veille par DPMS."""
    niveau, actif = c_ushort(), c_ubyte()
    return bool(xext and xext.DPMSInfo(dpy, byref(niveau), byref(actif)) and actif.value and niveau.value)


def session_ailleurs():
    """Session verrouillée (l'écran de connexion est sur une autre console) ou autre console affichée."""
    console = os.environ.get("XDG_VTNR")
    try:
        with open("/sys/class/tty/tty0/active") as f:
            return bool(console) and f.read().strip() != f"tty{console}"
    except OSError:
        return False


def pause_auto():
    try:
        with open(REGLAGE_PAUSE) as f:
            return f.read().strip() != "off"
    except OSError:
        return True


def rotation():
    """Réglage du changement de vidéo : (« temps », secondes, au hasard), (« espace », 0, False) ou None."""
    try:
        with open(REGLAGE_ROTATION) as f:
            mots = f.read().split()
    except OSError:
        return None
    if mots[:1] == ["espace"]:
        return ("espace", 0, False)
    if mots and mots[0].isdigit() and int(mots[0]) > 0:
        return ("temps", int(mots[0]) * 60, mots[1:2] == ["hasard"])
    return None


def couleur_moyenne(video):
    """Couleur moyenne d'une image de la vidéo, en RRGGBB, comme fond-anime (None sans ffmpeg)."""
    for debut in ("1", "0"):
        try:
            image = subprocess.run(["ffmpeg", "-v", "error", "-ss", debut, "-i", video, "-frames:v", "1",
                                    "-vf", "scale=1:1:flags=area", "-f", "rawvideo", "-pix_fmt", "rgb24", "-"],
                                   capture_output=True, timeout=30).stdout
        except (OSError, subprocess.TimeoutExpired):
            return None
        if len(image) == 3:
            return image.hex()
    return None


def memoriser(video):
    """La vidéo affichée devient celle que « fond-anime » relance (et que l'interface montre)."""
    try:
        with open(VIDEO_MEMORISEE + ".tmp", "w") as f:
            f.write(video + "\n")
        os.replace(VIDEO_MEMORISEE + ".tmp", VIDEO_MEMORISEE)
    except OSError:
        pass


class Rotation:
    """Change la vidéo de mpv dans sa liste de lecture, selon le réglage du changement de vidéo."""

    def __init__(self, prise, principal, sous_bureau):
        self.prise, self.principal, self.sous_bureau = prise, principal, sous_bureau
        self.visible = 0.0  # secondes de bureau visible depuis le dernier changement
        self.ecart = None   # « espace » : place dans la liste = espace de travail + écart
        self.couleurs = {}

    def mpv(self, *commande):
        return (commande_mpv(self.prise, *commande) or {}).get("data")

    def passage(self, reglage, cachee, espace, duree):
        if reglage is None or reglage[0] != "temps":
            self.visible = 0.0
        if reglage is None or reglage[0] != "espace":
            self.ecart = None
        if reglage is None or cachee:  # le temps ne compte que quand la vidéo se voit
            return
        if reglage[0] == "temps":
            self.visible += duree
            if self.visible < reglage[1]:
                return
            self.visible = 0.0
        n, place = self.mpv("get_property", "playlist-count"), self.mpv("get_property", "playlist-pos")
        if not isinstance(n, int) or not isinstance(place, int) or n < 2 or place < 0:
            return
        if reglage[0] == "temps":
            suivante = random.choice([i for i in range(n) if i != place]) if reglage[2] else (place + 1) % n
        else:
            if self.ecart is None:  # la vidéo du moment reste sur l'espace de travail du moment
                self.ecart = place - espace
            suivante = (espace + self.ecart) % n
            if suivante == place:
                return
        self.changer(suivante)

    def changer(self, place):
        video = self.mpv("get_property", f"playlist/{place}/filename")
        couleur = None
        if self.principal and self.sous_bureau and video:
            # Couleur du fond masqué de la nouvelle vidéo, calculée avant de la montrer
            if video not in self.couleurs:
                self.couleurs[video] = couleur_moyenne(video)
            couleur = self.couleurs[video]
        commande_mpv(self.prise, "playlist-play-index", place)
        if self.principal and video:
            memoriser(video)
            if couleur:  # sans couleur (ffmpeg absent), celle de la vidéo précédente reste
                try:
                    subprocess.run([os.path.join(ICI, "fond-anime-fond"), "masquer", couleur], timeout=60,
                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                except (OSError, subprocess.TimeoutExpired):
                    pass


def ecrans_xrandr():
    """Liste des écrans selon xrandr (pour voir quand un écran est branché ou débranché)."""
    try:
        return subprocess.run(["xrandr", "--listmonitors"], capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.TimeoutExpired):
        return None


def commande_mpv(prise, *commande):
    """Envoie une commande à mpv par sa prise IPC ; renvoie sa réponse (None s'il ne répond pas)."""
    try:
        with socket.socket(socket.AF_UNIX) as s:
            s.settimeout(1)
            s.connect(prise)
            s.sendall(json.dumps({"command": list(commande)}).encode() + b"\n")
            recu = b""
            while b'"error"' not in recu:  # mpv peut envoyer des événements avant la réponse
                bloc = s.recv(4096)
                if not bloc:
                    return None
                recu += bloc
    except OSError:
        return None
    try:
        return json.loads(next(l for l in recu.splitlines() if b'"error"' in l))
    except ValueError:
        return None


def preparer_type_bureau(dpy, fenetre, x, y, largeur, hauteur, a):
    """--type-bureau : ce que fait xwinwrap -fdt -b -s -st -sp -nf -ni -un, avant l'affichage."""
    ecrire(dpy, fenetre, a["_NET_WM_WINDOW_TYPE"], XA_ATOM, [a["_NET_WM_WINDOW_TYPE_DESKTOP"]])
    # Sous les applications, sur tous les espaces de travail, hors de la barre des tâches et du pager
    ecrire(dpy, fenetre, a["_NET_WM_STATE"], XA_ATOM, [a[f"_NET_WM_STATE_{etat}"] for etat in
                                                       ("BELOW", "STICKY", "SKIP_TASKBAR", "SKIP_PAGER")])
    ecrire(dpy, fenetre, a["_NET_WM_DESKTOP"], XA_CARDINAL, [0xFFFFFFFF])
    ecrire(dpy, fenetre, a["_MOTIF_WM_HINTS"], a["_MOTIF_WM_HINTS"], [2, 0, 0, 0, 0])  # sans décoration
    # Jamais le focus (WM_HINTS : InputHint | StateHint, pas de saisie, état normal)
    ecrire(dpy, fenetre, XA_WM_HINTS, XA_WM_HINTS, [1 | 2, 0, 1, 0, 0, 0, 0, 0, 0])
    # Position et taille imposées (USPosition | USSize | PPosition | PSize) : pas de placement automatique
    ecrire(dpy, fenetre, XA_WM_NORMAL_HINTS, XA_WM_SIZE_HINTS, [15, x, y, largeur, hauteur] + [0] * 13)
    # Zone de clic vide (ShapeInput, ShapeSet) : les clics passent à ce qui est dessous
    if xext:
        xext.XShapeCombineRectangles(dpy, fenetre, 2, 0, 0, None, 0, 0, 0)


def placer_au_dessus(dpy, racine, fenetre, voisine, a):
    """Place une fenêtre de type bureau juste au-dessus d'une autre, par _NET_RESTACK_WINDOW envoyé
    comme par un pager : Compiz refuse XRaiseWindow à une fenêtre qui ne prend pas le focus.
    xfwm4 ignore toute demande d'empilement d'une fenêtre de type bureau, mais n'en a pas besoin :
    l'état « dessous » (BELOW) y met la vidéo et les icônes dans une couche au-dessus de xfdesktop,
    et les icônes, affichées après la vidéo, restent au-dessus d'elle."""
    message = XClientMessageEvent(type=CLIENT_MESSAGE, window=fenetre, message_type=a["_NET_RESTACK_WINDOW"],
                                  format=32)
    message.data[:] = [2, voisine, 0, 0, 0]  # source : pager ; Above
    x11.XSendEvent(dpy, racine, 0, SUBSTRUCTURE_REDIRECT | SUBSTRUCTURE_NOTIFY, byref(message))


def role(dpy, fenetre, a):
    """« xfdesktop » ou « icônes » pour les fenêtres de type bureau qui encadrent la vidéo, sinon None."""
    if a["_NET_WM_WINDOW_TYPE_DESKTOP"] not in propriete(dpy, fenetre, a["_NET_WM_WINDOW_TYPE"]):
        return None
    classe = propriete(dpy, fenetre, a["WM_CLASS"], texte=True).split(b"\0")
    return {b"Xfdesktop": "xfdesktop", b"fond-anime-icones": "icônes"}.get(classe[1] if len(classe) > 1 else b"")


def garder_entre(dpy, racine, fenetre, a, roles):
    """--type-bureau : la vidéo reste au-dessus du bureau de xfdesktop (lancé ou relancé après elle,
    il repasserait devant) et sous les icônes de fond-anime-icones."""
    pile = propriete(dpy, racine, a["_NET_CLIENT_LIST_STACKING"])  # de bas en haut
    if fenetre not in pile:
        return  # pas encore prise en main par le gestionnaire de fenêtres
    for f in set(roles) - set(pile):
        del roles[f]
    for f in pile:
        if f not in roles:
            roles[f] = role(dpy, f, a)
    rang = pile.index(fenetre)
    bureaux = [f for f in pile[rang + 1:] if roles[f] == "xfdesktop"]
    icones = [f for f in pile if roles[f] == "icônes"]
    if bureaux:
        # Les icônes puis la vidéo, chacune juste au-dessus de xfdesktop : Compiz traite la seconde
        # demande avant d'avoir appliqué la première, la vidéo ne peut donc pas servir de repère
        for f in icones + [fenetre]:
            placer_au_dessus(dpy, racine, f, bureaux[-1], a)
    else:
        icones = [f for f in icones if pile.index(f) < rang]
        for f in icones:
            placer_au_dessus(dpy, racine, f, fenetre, a)
    if bureaux or icones:
        x11.XFlush(dpy)


def main():
    args = sys.argv[1:]
    type_bureau = bool(args) and args[0] == "--type-bureau"
    if type_bureau:
        args = args[1:]
    principal = len(args) > 1 and args[1] == "--principal"
    if principal:
        args = args[:1] + args[2:]
    geometrie_voulue = re.fullmatch(r"(\d+)x(\d+)\+(-?\d+)\+(-?\d+)", args[0]) if args else None
    if not geometrie_voulue or len(args) < 3 or args[1] != "--":
        sys.exit("Usage : fond-anime-video [--type-bureau] LxH+X+Y [--principal] -- LECTEUR … WID …")
    largeur, hauteur, x, y = map(int, geometrie_voulue.groups())

    dpy = x11.XOpenDisplay(None)
    if not dpy:
        sys.exit("fond-anime-video : pas d'affichage X")
    racine = x11.XDefaultRootWindow(dpy)
    atomes = {nom: x11.XInternAtom(dpy, nom.encode(), 0) for nom in ATOMES}
    attributs = XSetWindowAttributes(background_pixel=0, override_redirect=0 if type_bureau else 1)
    fenetre = x11.XCreateWindow(dpy, racine, x, y, largeur, hauteur, 0, 0, INPUT_OUTPUT, None,
                                CW_BACK_PIXEL | CW_OVERRIDE_REDIRECT, byref(attributs))
    # Classe reprise par la règle picom du fond animé : ni ombre, ni arrondi, ni animation
    x11.XSetClassHint(dpy, fenetre, byref(XClassHint(b"fond-anime-video", b"fond-anime-mpv")))
    x11.XStoreName(dpy, fenetre, b"fond-anime")
    if type_bureau:
        preparer_type_bureau(dpy, fenetre, x, y, largeur, hauteur, atomes)
    else:
        x11.XLowerWindow(dpy, fenetre)  # abaissée avant d'apparaître : jamais au-dessus du bureau
    x11.XMapWindow(dpy, fenetre)
    x11.XFlush(dpy)

    commande = [hex(fenetre) if a == "WID" else a for a in args[2:]]
    prise = next((a.split("=", 1)[1] for a in commande if a.startswith("--input-ipc-server=")), None)
    lecteur = subprocess.Popen(AVEC_PARENT + commande, stdin=subprocess.DEVNULL)
    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(sig, lambda *_: lecteur.terminate())
    roles = {}  # rôle des fenêtres déjà vues, pour --type-bureau
    changement = Rotation(prise, principal, not type_bureau) if prise else None
    # Écrans au départ (vidéo principale) : s'ils changent deux contrôles de suite (toutes les
    # 5 secondes), le fond animé est relancé pour s'y ajuster
    ecrans, ecarts, tour = ecrans_xrandr() if principal else None, 0, 0
    avant = time.monotonic()
    while lecteur.poll() is None:
        if type_bureau:
            garder_entre(dpy, racine, fenetre, atomes, roles)
        elif not tout_en_bas(dpy, racine, fenetre, atomes):
            x11.XLowerWindow(dpy, fenetre)
            x11.XFlush(dpy)
        if prise:
            cachee = pause_auto() and (bureau_cache(dpy, racine, atomes, (x, y, largeur, hauteur))
                                       or ecran_eteint(dpy) or session_ailleurs())
            # On relit l'état réel de mpv à chaque passage : une pause demandée pendant son
            # démarrage peut se perdre, elle est alors simplement redemandée
            reponse = commande_mpv(prise, "get_property", "pause")
            if reponse and reponse.get("data") != cachee:
                commande_mpv(prise, "set_property", "pause", cachee)
            maintenant = time.monotonic()
            espace = (propriete(dpy, racine, atomes["_NET_CURRENT_DESKTOP"]) or [0])[0]
            changement.passage(rotation(), cachee, espace, maintenant - avant)
            avant = maintenant
        tour += 1
        if ecrans and tour % 5 == 0:
            ecarts = ecarts + 1 if ecrans_xrandr() not in (ecrans, None) else 0
            if ecarts == 2:
                subprocess.Popen([os.path.join(ICI, "fond-anime"), "actualiser"], start_new_session=True,
                                 stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        time.sleep(1)
    x11.XDestroyWindow(dpy, fenetre)
    x11.XCloseDisplay(dpy)


if __name__ == "__main__":
    main()
