#!/bin/bash
# bureau-modeles : met en place les réglages de départ du projet (modèles de config/)
# qui manquent encore. Un fichier déjà présent n'est jamais écrasé.
#   bureau-modeles   installe ce qui manque et l'affiche (rien à dire : n'affiche rien)
# (~/.config ci-dessous : $XDG_CONFIG_HOME s'il est défini)
#
# Lancé par installer.sh, par bureau-reglages à son ouverture et par fond-anime.
#   ~/.config/picom/picom.conf             réglages de picom 12 (ombres, coins, animations, règles)
#   ~/.config/picom/fond-anime.glsl        shader du fond animé
#   ~/.config/gtk-3.0/gtk.css.desactive    style du Alt+Tab, désactivé (à allumer dans l'interface)
#   ~/.config/autostart/picom.desktop      picom au démarrage ; désactivé si picom ne tourne pas
#   ~/.config/autostart/compiz.desktop     Compiz au démarrage ; désactivé hors du mode Compiz
#   ~/.config/bureau-profils/{sombre,clair} profils d'exemple (apparence seulement), au tout premier
#                                          lancement : un dossier de profils déjà là n'est pas touché
set -u
ICI="$(dirname "$(realpath "$0")")"
MODELES="$ICI/../config"
CONF="${XDG_CONFIG_HOME:-$HOME/.config}"

case "${1:-}" in
    "") ;;
    *) sed -n '2,5p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac

# Commande à écrire dans une entrée de démarrage, en chemin complet (le PATH de la session n'a
# pas forcément ~/.local/bin) : un lien vers ce script trouvé dans le PATH ou dans ~/.local/bin
# (installer.sh), /usr/bin pour un paquet…, sinon le script lui-même
chemin_commande() {
    local d IFS=:
    for d in $PATH "$HOME/.local/bin"; do
        [ "$d" != "$ICI" ] && [ -x "$d/$1" ] && [ "$(realpath "$d/$1" 2>/dev/null)" = "$ICI/$1" ] &&
            { echo "$d/$1"; return; }
    done
    echo "$ICI/$1"
}

# copier MODELE DESTINATION : seulement si la destination n'existe pas
copier() {
    [ -e "$2" ] && return 1
    mkdir -p "$(dirname "$2")"
    # u+w : la copie reste modifiable même si le modèle est en lecture seule (paquet…)
    cp "$MODELES/$1" "$2" && chmod u+w "$2" && echo "Ajouté : ${2/#$HOME/\~}"
}

# Rendu OpenGL logiciel (machine virtuelle sans accélération 3D…) : picom en glx ne redessine
# plus l'écran (panneau relancé invisible, fenêtres figées) ; xrender marche, sans le shader
# du fond animé
if copier picom/picom.conf "$CONF/picom/picom.conf" && "$ICI/rendu-logiciel"; then
    sed -i 's|^backend = "glx";|# Rendu logiciel détecté (pas d’accélération 3D) : glx ne redessine plus l’écran, xrender\n# marche. Le fond animé sous le bureau a besoin de glx.\nbackend = "xrender";|' \
        "$CONF/picom/picom.conf"
    echo "Rendu logiciel : picom réglé en xrender"
fi
copier picom/fond-anime.glsl "$CONF/picom/fond-anime.glsl"

# Profils d'exemple au tout premier lancement : un dossier de profils déjà là (profils à soi,
# exemples mis à la corbeille) n'est pas touché, les exemples ne reviennent donc pas
if [ ! -e "$CONF/bureau-profils" ] && [ -d "$MODELES/profils" ]; then
    for d in "$MODELES/profils"/*/; do
        n=$(basename "$d")
        mkdir -p "$CONF/bureau-profils/$n"
        cp "$d/reglages.conf" "$CONF/bureau-profils/$n/" && chmod u+w "$CONF/bureau-profils/$n/reglages.conf" &&
            echo "Ajouté : profil d'exemple « $n »"
    done
fi

# Alt+Tab : un gtk.css à soi (sans le style du projet) est laissé tel quel
if [ ! -e "$CONF/gtk-3.0/gtk.css" ]; then
    copier gtk-3.0/alttab.css "$CONF/gtk-3.0/gtk.css.desactive"
fi

# Démarrage automatique : l'entrée n'est active que si elle correspond à ce qui tourne déjà,
# pour ne rien changer à la prochaine ouverture de session sans que l'utilisateur l'ait choisi
AUTO="$CONF/autostart"
if copier autostart/picom.desktop "$AUTO/picom.desktop"; then
    pgrep -x picom >/dev/null || echo "Hidden=true" >> "$AUTO/picom.desktop"
fi
if copier autostart/compiz.desktop "$AUTO/compiz.desktop"; then
    wm="$(chemin_commande bureau-wm)"
    wm="${wm//&/\\&}"  # « & » a un sens pour sed
    sed -i "s|@BUREAU_WM@|$wm|" "$AUTO/compiz.desktop"
    [ "$(cat "$CONF/bureau-wm" 2>/dev/null)" = compiz ] || echo "Hidden=true" >> "$AUTO/compiz.desktop"
fi
exit 0
