#!/usr/bin/env bash
# fond-anime : fond d'écran animé à partir d'une vidéo (XFCE / X11)
# Dépendances : mpv, xrandr, ffmpeg (couleur de masquage) ; picom en glx pour la vidéo sous le bureau
#
#   fond-anime VIDEO.mp4     lance la vidéo en fond d'écran (et la mémorise)
#   fond-anime               relance la dernière vidéo mémorisée
#   fond-anime stop          arrête le fond animé
#   fond-anime actualiser    replace le fond animé s'il tourne (après un changement de
#                            profil ou de gestionnaire de fenêtres), sinon remet le fond d'écran
#   fond-anime auto on|off   active / désactive le lancement à l'ouverture de session
#   fond-anime pause-auto on|off  met la vidéo en pause tant qu'elle ne se voit pas
#                            (fenêtre en plein écran ou agrandie, écran éteint, session
#                            verrouillée) ; activé par défaut
#   fond-anime rotation MINUTES [hasard]  passe à la vidéo suivante de la galerie (ou à une
#                            autre, au hasard) après MINUTES minutes de bureau visible
#   fond-anime rotation espace   une vidéo par espace de travail, dans l'ordre de la galerie
#   fond-anime rotation off  garde la même vidéo (par défaut)
#
# Avec picom en glx, la vidéo passe sous le vrai bureau (xfdesktop) dont picom rend le fond
# transparent : les icônes restent celles d'XFCE (déplacer, supprimer, créer…).
# Sinon (Compiz, picom en xrender faute d'accélération 3D, picom arrêté), la vidéo se pose sur le
# bureau dans une fenêtre de type bureau, et fond-anime-icones réaffiche les icônes par-dessus,
# sans pouvoir les déplacer.
# Plusieurs écrans : une vidéo par écran, chacune à la taille du sien et mise en pause pour lui
# seul ; le fond animé se relance tout seul quand un écran est branché ou débranché.

set -u
ICI="$(dirname "$(realpath "$0")")"
CONF="${XDG_CONFIG_HOME:-$HOME/.config}"
CONF_DIR="$CONF/fond-anime"
SAVED="$CONF_DIR/video"
PIDFILE="$CONF_DIR/pid"
AUTOSTART="$CONF/autostart/fond-anime.desktop"
# Remet le fond d'écran à l'ouverture de session s'il est resté masqué (session fermée
# pendant le fond animé) : créé quand le fond est masqué, enlevé quand il est remis
NETTOYAGE="$CONF/autostart/fond-anime-nettoyage.desktop"
PICOM_CONF="$CONF/picom/picom.conf"
SHADER=fond-anime.glsl
# Prise de commande de mpv : fond-anime-video s'en sert pour la pause automatique et le
# changement de vidéo. Premier écran : fond-anime-mpv.sock (lue aussi par l'interface), les
# suivants : fond-anime-mpv-1.sock, -2…
PRISE_BASE="${XDG_RUNTIME_DIR:-$CONF_DIR}/fond-anime-mpv"
PRISE="$PRISE_BASE.sock"
PAUSE_AUTO="$CONF_DIR/pause-auto"
ROTATION="$CONF_DIR/rotation"  # « off », « MINUTES ordre », « MINUTES hasard » ou « espace »
EXT_VIDEOS='mp4|webm|mkv|mov|m4v|avi|ogv|gif'  # comme la galerie de l'interface

mkdir -p "$CONF_DIR"

# Commande à écrire dans une entrée de démarrage, en chemin complet (le PATH de la session n'a
# pas forcément ~/.local/bin) : un lien vers ce script trouvé dans le PATH ou dans ~/.local/bin
# (installation de développement), /usr/bin pour un paquet…, sinon le script lui-même
chemin_commande() {
    local d IFS=:
    for d in $PATH "$HOME/.local/bin"; do
        [ "$d" != "$ICI" ] && [ -x "$d/$1" ] && [ "$(realpath "$d/$1" 2>/dev/null)" = "$ICI/$1" ] &&
            { echo "$d/$1"; return; }
    done
    echo "$ICI/$1"
}

# Motifs ancrés sur le programme lancé : un éditeur ou un grep qui cite ces noms n'est pas visé.
# Processus de ce compte seulement (-u) : sinon, avec un autre compte ouvert en même temps, son
# picom ou sa vidéo font croire que ceux de cette session tournent
en_cours() { pgrep -u "$(id -u)" -f "^mpv .*fond-anime-mp[v]" >/dev/null; }

arreter_video() {
    local pid
    if [[ -f "$PIDFILE" ]]; then  # une vidéo par écran : un numéro par ligne
        while read -r pid; do [ -z "$pid" ] || kill "$pid" 2>/dev/null; done < "$PIDFILE"
        rm -f "$PIDFILE"
    fi
    # au cas où une instance aurait été lancée hors du script
    pkill -u "$(id -u)" -f "^python3 [^ ]*/fond-anime-vide[o] " 2>/dev/null
    pkill -u "$(id -u)" -f "^python3 [^ ]*/fond-anime-icone[s]" 2>/dev/null
    rm -f "$PRISE_BASE"-[0-9]*.sock  # prises des écrans en plus (mpv ne les retire pas en partant)
    return 0
}

# Dossier des vidéos de la galerie, comme l'interface : celui du logiciel s'il est modifiable
# (copie de git), sinon ~/.local/share/bureau-reglages/fonds-animes (logiciel dans /usr)
dossier_videos() {
    local logiciel; logiciel=$(dirname "$ICI")
    if [ -d "$logiciel/fonds-animes" ]; then [ -w "$logiciel/fonds-animes" ] && { echo "$logiciel/fonds-animes"; return; }
    elif [ -w "$logiciel" ]; then echo "$logiciel/fonds-animes"; return
    fi
    echo "${XDG_DATA_HOME:-$HOME/.local/share}/bureau-reglages/fonds-animes"
}

# Liste de lecture de mpv : les vidéos de la galerie, dans l'ordre où l'interface les montre
# (noms sans tenir compte des majuscules, tri de Python : celui de sort dépend de la langue),
# plus la vidéo choisie si elle est rangée ailleurs. Remplit LISTE, et DEPART (place de la vidéo
# choisie).
preparer_liste() {
    local choisie f i
    choisie=$(realpath "$1")
    LISTE=() DEPART=0
    while IFS= read -r -d '' f; do LISTE+=("$f"); done < <(python3 - "$(dossier_videos)" "$EXT_VIDEOS" <<'EOF'
import os, sys
dossier, extensions = sys.argv[1], tuple("." + e for e in sys.argv[2].split("|"))
try:
    noms = sorted(os.listdir(dossier), key=str.casefold)
except OSError:
    noms = []
for nom in noms:
    if nom.lower().endswith(extensions) and os.path.isfile(os.path.join(dossier, nom)):
        sys.stdout.write(os.path.join(dossier, nom) + "\0")
EOF
)
    for i in "${!LISTE[@]}"; do
        if [ "$(realpath "${LISTE[$i]}")" = "$choisie" ]; then DEPART=$i; return; fi
    done
    LISTE=("$choisie" "${LISTE[@]}")
}

# Écrans : « LxH+X+Y » de chacun (xrandr --listmonitors), sinon l'écran entier
ecrans() {
    local e
    e=$(xrandr --listmonitors 2>/dev/null |
        sed -n 's|^ *[0-9]*: [^ ]* \([0-9]*\)/[0-9]*x\([0-9]*\)/[0-9]*\([+-][0-9]*\)\([+-][0-9]*\) .*|\1x\2\3\4|p')
    [ -n "$e" ] || e="$(xrandr 2>/dev/null | sed -n 's/.*current \([0-9]*\) x \([0-9]*\).*/\1x\2/p')+0+0"
    printf '%s\n' "$e"
}

# lancer_videos [--type-bureau] : une fenêtre de vidéo par écran. La première (--principal)
# mémorise la vidéo quand elle change, met à jour la couleur du fond masqué et relance le fond
# animé quand les écrans changent.
lancer_videos() {
    local g i=0 prise
    local -a options
    : > "$PIDFILE"
    while read -r g; do
        [ -n "$g" ] || continue
        prise="$PRISE"; options=(--principal)
        if [ "$i" -gt 0 ]; then prise="$PRISE_BASE-$i.sock"; options=(); fi
        "$ICI/fond-anime-video" "$@" "$g" "${options[@]}" -- "${LECTEUR[@]}" --input-ipc-server="$prise" \
            -- "${LISTE[@]}" >/dev/null 2>&1 &
        echo $! >> "$PIDFILE"
        disown
        i=$((i + 1))
    done < <(ecrans)
}

# Couleur moyenne d'une image de la vidéo, en RRGGBB : le fond masqué du bureau prend cette
# couleur, pour que les bords des icônes et l'ombre de leurs noms se fondent dans la vidéo
couleur_video() {
    local c debut
    for debut in 1 0; do
        c="$(ffmpeg -v error -ss "$debut" -i "$1" -frames:v 1 -vf scale=1:1:flags=area \
             -f rawvideo -pix_fmt rgb24 - 2>/dev/null | od -An -tx1 | tr -d ' \n')"
        if [[ ${#c} -eq 6 ]]; then echo "$c"; return; fi
    done
}

masquer_fond() {
    mkdir -p "$(dirname "$NETTOYAGE")"
    cat > "$NETTOYAGE" <<EOF
[Desktop Entry]
Type=Application
Name=Fond animé : remise du fond d'écran
Exec="$(chemin_commande fond-anime)" actualiser
X-GNOME-Autostart-enabled=true
EOF
    "$ICI/fond-anime-fond" masquer ${1:+"$1"}
}

restaurer_fond() {
    "$ICI/fond-anime-fond" restaurer
    rm -f "$NETTOYAGE"
}

# picom compose l'écran (mode xfwm4) ; à l'ouverture de session, il peut démarrer un peu après
picom_pret() {
    [ "$("$ICI/bureau-wm" 2>/dev/null)" != compiz ] || return 1
    pgrep -u "$(id -u)" -x picom >/dev/null && return 0
    [ -f "$CONF/autostart/picom.desktop" ] &&
        ! grep -qx 'Hidden=true' "$CONF/autostart/picom.desktop" || return 1
    for _ in $(seq 20); do
        sleep 0.5
        pgrep -u "$(id -u)" -x picom >/dev/null && return 0
    done
    return 1
}

# Shader et règle xfdesktop dans picom.conf, ajoutés ou mis à jour s'il le faut (profil
# plus ancien…). La règle ne vaut que si le bureau porte la propriété _FOND_ANIME.
preparer_picom() {
    [ -f "$PICOM_CONF" ] || "$ICI/bureau-modeles" >/dev/null
    [ -f "$PICOM_CONF" ] && grep -q '^rules = (' "$PICOM_CONF" || return 1
    # Le shader qui rend le bureau transparent demande glx (en xrender : rendu logiciel)
    ! grep -q '^backend = "xrender"' "$PICOM_CONF" || return 1
    local dossier change=0
    dossier="$(dirname "$PICOM_CONF")"
    if ! cmp -s "$ICI/../config/picom/$SHADER" "$dossier/$SHADER"; then
        cp -f "$ICI/../config/picom/$SHADER" "$dossier/$SHADER" && chmod u+w "$dossier/$SHADER" || return 1
        change=1
    fi
    if ! grep -q "_FOND_ANIME@" "$PICOM_CONF"; then
        REGLE="  # Fond animé : pendant la vidéo (propriété _FOND_ANIME), le fond uni de xfdesktop devient transparent
  { match = \"class_g = 'Xfdesktop' && window_type = 'desktop' && _FOND_ANIME@\"; shader = \"$SHADER\"; opacity = 0.99; }," \
            awk '/fond-anime\.glsl|# Fond animé : (la couleur|pendant la vidéo)/ { next }
                 { print } /^rules = \(/ { print ENVIRON["REGLE"] }' "$PICOM_CONF" > "$PICOM_CONF.tmp" &&
            mv "$PICOM_CONF.tmp" "$PICOM_CONF" || return 1
        change=1
    fi
    if [ "$change" = 1 ]; then
        # picom est relancé pour prendre le nouveau shader ; le panneau ensuite, sinon la
        # zone de survol du dock se retrouve en haut à gauche
        "$ICI/relancer-picom" >/dev/null
    fi
}

# Pourquoi la vidéo ne peut pas passer sous le bureau (ses icônes sont alors en lecture seule)
pourquoi_par_dessus() {
    if [ "$("$ICI/bureau-wm" 2>/dev/null)" = compiz ]; then
        echo "avec Compiz, picom ne tourne pas"
    elif ! command -v picom >/dev/null; then
        echo "picom n'est pas installé (sudo apt install picom)"
    elif grep -q '^backend = "xrender"' "$PICOM_CONF" 2>/dev/null; then
        echo "picom est en xrender, faute d’accélération 3D (la vidéo sous le bureau demande glx)"
    else
        echo "picom ne tourne pas, ou ${PICOM_CONF/#$HOME/\~} n'a pas de bloc « rules = ( … ) » (picom 12)"
    fi
}

stop() {
    restaurer_fond  # le fond d'écran revient avant que la vidéo disparaisse
    arreter_video
}

start() {
    local video="$1"
    if [[ ! -f "$video" ]]; then
        echo "Vidéo introuvable : $video" >&2; exit 1
    fi
    if ! command -v mpv >/dev/null; then
        echo "mpv n'est pas installé. Lance : sudo apt install mpv" >&2; exit 1
    fi
    realpath "$video" > "$SAVED"

    # Décodage matériel, sauf en rendu logiciel : mpv s'y bloque en cherchant un décodeur Vulkan
    local hwdec=auto-safe
    if "$ICI/rendu-logiciel"; then hwdec=no; fi

    # Toute la galerie dans la liste de lecture, en commençant par la vidéo choisie : chaque
    # vidéo tourne en boucle, fond-anime-video passe à une autre selon « fond-anime rotation »
    preparer_liste "$(cat "$SAVED")"
    LECTEUR=(mpv -wid WID
        # Sans accélération graphique, mpv se rabattrait sur sdl, qui ignore -wid et ouvre sa
        # propre fenêtre : seulement des sorties qui s'intègrent, et le rendu logiciel accepté
        "--vo=gpu,gpu-next,x11" --gpu-sw=yes  # un seul élément : liste de sorties pour mpv
        --x11-name=fond-anime-mpv
        --loop-file=inf --loop-playlist=inf --playlist-start="$DEPART"
        --no-audio
        --panscan=1.0
        --hwdec="$hwdec"
        --no-osc --no-osd-bar --osd-level=0
        --no-input-default-bindings --input-vo-keyboard=no
        --cursor-autohide=no
        --stop-screensaver=no
        --profile=fast
        --really-quiet)

    arreter_video
    if picom_pret && preparer_picom; then
        # fenêtres hors du gestionnaire de fenêtres, gardées tout en bas, sous xfdesktop
        lancer_videos
        sleep 1  # la vidéo est en place sous le bureau avant que son fond devienne transparent
        masquer_fond "$(couleur_video "$(cat "$SAVED")")"
        echo "Fond animé lancé derrière les icônes du bureau : $(cat "$SAVED")"
    else
        restaurer_fond
        # Fenêtres de type bureau, gérées par le gestionnaire de fenêtres (comme xwinwrap -fdt) :
        # au-dessus du fond de xfdesktop, sous les applications
        lancer_videos --type-bureau
        # la vidéo cache les icônes de xfdesktop : on les réaffiche par-dessus
        (sleep 1; exec python3 "$ICI/fond-anime-icones") >/dev/null 2>&1 &
        disown
        echo "Fond animé lancé par-dessus le bureau : $(cat "$SAVED")"
        echo "Icônes en lecture seule, car $(pourquoi_par_dessus)."
    fi
}

autostart() {
    case "${1:-}" in
        on)
            mkdir -p "$(dirname "$AUTOSTART")"
            cat > "$AUTOSTART" <<EOF
[Desktop Entry]
Type=Application
Name=Fond d'écran animé
Exec=sh -c "sleep 3; '$(chemin_commande fond-anime)'"
X-GNOME-Autostart-enabled=true
EOF
            echo "Démarrage automatique activé." ;;
        off)
            rm -f "$AUTOSTART"
            echo "Démarrage automatique désactivé." ;;
        *)
            echo "Usage : fond-anime auto on|off" >&2; exit 1 ;;
    esac
}

case "${1:-}" in
    stop)  stop; echo "Fond animé arrêté." ;;
    actualiser)
        if en_cours && [[ -f "$SAVED" ]]; then start "$(cat "$SAVED")"
        else restaurer_fond; fi ;;
    auto)  autostart "${2:-}" ;;
    pause-auto)
        # Lu chaque seconde par fond-anime-video : pas besoin de relancer la vidéo
        case "${2:-}" in
            on|off) echo "$2" > "$PAUSE_AUTO"
                    if [ "$2" = on ]; then echo "Pause automatique activée."
                    else echo "Pause automatique désactivée."; fi ;;
            *) echo "Usage : fond-anime pause-auto on|off" >&2; exit 1 ;;
        esac ;;
    rotation)
        # Lu chaque seconde par fond-anime-video : pas besoin de relancer la vidéo
        case "${2:-}:${3:-}" in
            off:) echo off > "$ROTATION"; echo "Changement de vidéo désactivé." ;;
            espace:) echo espace > "$ROTATION"; echo "Une vidéo par espace de travail." ;;
            [1-9]*:|[1-9]*:ordre|[1-9]*:hasard)
                if [[ ! $2 =~ ^[0-9]+$ ]]; then echo "Nombre de minutes invalide : $2" >&2; exit 1; fi
                echo "$2 ${3:-ordre}" > "$ROTATION"
                quand="toutes les $2 minutes"; [ "$2" != 1 ] || quand="chaque minute"
                if [ "${3:-ordre}" = hasard ]; then echo "Autre vidéo au hasard $quand."
                else echo "Vidéo suivante $quand."; fi ;;
            *) echo "Usage : fond-anime rotation MINUTES [hasard] | espace | off" >&2; exit 1 ;;
        esac ;;
    -h|--help) sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//' ;;
    "")
        if [[ -f "$SAVED" ]]; then start "$(cat "$SAVED")"
        else echo "Aucune vidéo mémorisée. Usage : fond-anime VIDEO.mp4" >&2; exit 1; fi ;;
    *)     start "$1" ;;
esac
